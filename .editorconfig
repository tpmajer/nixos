# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Two trailing spaces are a line break.
[*.md]
trim_trailing_whitespace = false

# Written by nix, never by hand.
[flake.lock]
trim_trailing_whitespace = false
insert_final_newline = false
