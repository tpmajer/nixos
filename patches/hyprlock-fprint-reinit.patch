+bool CFingerprint::scheduleReinit() {
+    if (m_sDBUSState.sleeping || m_sDBUSState.reinits >= 5)
+        return false;
+    m_sDBUSState.reinits++;
+    Log::logger->log(Log::INFO, "fprint: scheduling device reinit (attempt {})", m_sDBUSState.reinits);
+    g_pHyprlock->addTimer(std::chrono::milliseconds(3000), [](ASP<CTimer> self, void* data) { ((CFingerprint*)data)->reinitDevice(); }, this);
+    return true;
+}
+
+void CFingerprint::reinitDevice() {
+    // The old proxy points at a device object that no longer exists in fprintd
+    // (e.g. the reader re-enumerated on the USB bus after resume).
+    m_sDBUSState.device.reset();
+    m_sDBUSState.done      = false;
+    m_sDBUSState.abort     = false;
+    m_sDBUSState.verifying = false;
+    startVerify();
+}
+
