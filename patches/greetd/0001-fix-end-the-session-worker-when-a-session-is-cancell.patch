From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomasz Majer <17414256+tpmajer@users.noreply.github.com>
Date: Sun, 11 Oct 2026 09:16:28 +0200
Subject: [PATCH] fix: end the session worker when a session is cancelled

The worker only reads Cancel between PAM's questions. A module that
waits by itself, pam_fprintd for a finger, kept a cancelled session's
worker, and the reader with it, until its own timeout. A session that
has not been started has opened nothing, so the worker is sent
SIGTERM as well.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 greetd/src/session/interface.rs | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/greetd/src/session/interface.rs b/greetd/src/session/interface.rs
index 7e6c502..7141e9e 100644
--- a/greetd/src/session/interface.rs
+++ b/greetd/src/session/interface.rs
@@ -180,8 +180,13 @@ impl Session {
     /// Cancel the session.
     pub async fn cancel(&mut self) -> Result<(), Error> {
         self.last_msg = None;
-        ParentToSessionChild::Cancel.send(&mut self.sock).await?;
-        Ok(())
+        let sent = ParentToSessionChild::Cancel.send(&mut self.sock).await;
+        // The worker only reads Cancel between PAM's questions, so a module
+        // that waits, such as a fingerprint reader's, would hold it until
+        // its timeout. A session that has not been started has nothing to
+        // tear down, so end the worker instead.
+        let _ = nix::sys::signal::kill(self.task, Signal::SIGTERM);
+        sent
     }
 
     /// Send a response to an authentication question, or None to cancel the
