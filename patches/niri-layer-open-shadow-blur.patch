+    /// Scale that the offscreen contents are currently drawn at.
+    ///
+    /// Effects that sample the output framebuffer, like the background effect, cannot be baked
+    /// into the offscreen, so they are drawn separately and need to follow this scale to stay
+    /// aligned with the surface. A custom shader can transform the contents arbitrarily, so
+    /// there is nothing meaningful to follow and this reports 1.
+    pub fn contents_scale(&self) -> f64 {
+        if self.custom_shader.is_some() {
+            return 1.;
+        }
+
+        (self.anim.value() / 2. + 0.5).max(0.)
+    }
