+bool CFingerprint::scheduleReinit() {
+    if (m_sDBUSState.sleeping || m_sDBUSState.reinits >= 5)
+        return false;
+    m_sDBUSState.reinits++;
+    // Quick retries cover the ~5s re-enumeration window after resume. If they
+    // all fail, fprintd itself is likely wedged by a timed-out open ("already
+    // open" on every claim) and only recovers by idle-exiting 30s after our
+    // last D-Bus call - so back off past that, and the next attempt will
+    // D-Bus-activate a fresh fprintd.
+    const auto delay = m_sDBUSState.reinits <= 3 ? 3000 : 40000;
+    Log::logger->log(Log::INFO, "fprint: scheduling device reinit (attempt {}, in {}ms)", m_sDBUSState.reinits, delay);
+    g_pHyprlock->addTimer(std::chrono::milliseconds(delay), [](ASP<CTimer> self, void* data) { ((CFingerprint*)data)->reinitDevice(); }, this);
+    return true;
+}
+
+void CFingerprint::reinitDevice() {
+    // The old device object may be gone from fprintd (reader re-enumerated on
+    // the USB bus after resume) - then Release just fails and is ignored. But
+    // if the object survived, our previous claim is still registered and the
+    // new Claim would be denied with AlreadyInUse, so release it first.
+    releaseDevice();
+    m_sDBUSState.device.reset();
+    m_sDBUSState.done      = false;
+    m_sDBUSState.abort     = false;
+    m_sDBUSState.verifying = false;
+    startVerify();
+}
